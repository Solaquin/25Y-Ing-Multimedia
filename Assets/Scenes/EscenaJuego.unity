    - target: {fileID: 9113133203633605598, guid: 0e2b630ba48c2f943a1f5ba399f81540, type: 3}
      propertyPath: 'dialogos.Array.data[1]'
      value: "El camino hacia la gloria est\xE1 lleno de peligros."
      objectReference: {fileID: 0}
    - target: {fileID: 9113133203633605598, guid: 0e2b630ba48c2f943a1f5ba399f81540, type: 3}
      propertyPath: 'dialogos.Array.data[2]'
      value: "Nunca subestimes a tus enemigos, incluso los m\xE1s peque\xF1os."
      objectReference: {fileID: 0}
    - target: {fileID: 9113133203633605598, guid: 0e2b630ba48c2f943a1f5ba399f81540, type: 3}
      propertyPath: 'dialogos.Array.data[3]'
      value: "Si luchas con honor, siempre tendr\xE1s mi respeto."
      objectReference: {fileID: 0}
    - target: {fileID: 9113133203633605598, guid: 0e2b630ba48c2f943a1f5ba399f81540, type: 3}
      propertyPath: 'dialogos.Array.data[4]'
      value: 'Presiona E para continuar '
